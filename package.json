{
  "name": "pi-bedrouter",
  "version": "0.2.0",
  "description": "Pi extension for bedrouter: starts the cost-aware Bedrock model router, registers it as a provider, and shows which model served each request",
  "keywords": [
    "pi-package",
    "pi-extension",
    "bedrock",
    "aws",
    "model-router",
    "cost",
    "claude",
    "gpt-oss"
  ],
  "license": "MIT",
  "author": "Barry Melton",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bmelton/pi-bedrouter.git"
  },
  "homepage": "https://github.com/bmelton/pi-bedrouter#readme",
  "bugs": {
    "url": "https://github.com/bmelton/pi-bedrouter/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ]
  },
  "files": [
    "extensions",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "prepublishOnly": "npm test && npm run typecheck"
  },
  "dependencies": {
    "bedrouter": "^0.1.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.85.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.85.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
